# ==============================================================================
# LLM Provider Configuration for Agent Guardrail
# ==============================================================================
# In normal workflow, configure your LLM provider to synthesize patches and
# sanitize prompt injections dynamically.
# When unset or when DEMO_MODE=true, the system seamlessly uses pre-calculated
# AST heuristics and golden fixtures (for deterministic zero-dependency demo).

# OpenAI API Key (or compatible provider)
OPENAI_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Optional: Custom endpoint (e.g. Local Ollama, vLLM, or LiteLLM proxy)
# LLM_API_BASE=http://localhost:11434/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

# Execution Mode:
# Set to 'true' to force pre-calculated offline demo behavior (no external network calls)
DEMO_MODE=false

